# Local data directory for tenant DuckDB files and ingest manifests.
CLINIC_ANALYST_DATA_DIR=./data

# Render / web warehouse file. DuckDB only — not Postgres, not Snowflake.
# Local web: WAREHOUSE_PATH=./data/clinic.duckdb
# Render Blueprint default: /data/clinic.duckdb
# WAREHOUSE_PATH=./data/clinic.duckdb

# Default demo tenant. Generic clinic — not a Boom brand.
CLINIC_ANALYST_TENANT=example-clinic

# Optional as-of date (YYYY-MM-DD). Defaults to today.
# CLINIC_ANALYST_AS_OF=2026-09-02

# Optional LLM prose rewrite of already-computed facts. Never a source of numbers.
# OPENAI_API_KEY=

# Snowflake path (not used by the local demo). Do not point a demo tenant at Boom live data.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=BOOMREPORTING
# SNOWFLAKE_SCHEMA=PREP
