# Users, sessions, and per-tenant DuckDB files live here.
# Render Blueprint: /data  (auth.sqlite + tenants/{id}/warehouse.duckdb)
CLINIC_ANALYST_DATA_DIR=./data

# Cookie signing. Render generates this. Do not commit a production secret.
# CLINIC_ANALYST_SECRET=

# Documented demo login (PHI-free, not a production secret):
#   demo@example.clinic / demo-clinic-2026
# CLINIC_ANALYST_DEMO_PASSWORD=demo-clinic-2026

# Optional as-of date (YYYY-MM-DD). Defaults to today.
# CLINIC_ANALYST_AS_OF=2026-09-02

# xAI Grok (OpenAI-compatible chat completions at https://api.x.ai/v1).
# When set, the analyst uses tool-calling. When unset, keyword routing is used.
# Default model id grok-4.6 is the current chat model published at https://x.ai/api (Sep 2026).
# XAI_API_KEY=
# XAI_MODEL=grok-4.6

# Optional leftover. Not used as a source of numbers.
# OPENAI_API_KEY=

# Snowflake path (not used by the local demo). Do not point a demo tenant at Boom live data.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=BOOMREPORTING
# SNOWFLAKE_SCHEMA=PREP
